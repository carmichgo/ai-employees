# Database (Neon Postgres — shared between Vercel and DO)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_employees

# Redis (only needed on DO droplet — set automatically by docker-compose)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# Encryption (for storing channel credentials)
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# Inter-service auth (Vercel → DO API)
# Generate with: openssl rand -hex 32
# Set as INTERSERVICE_SECRET on DO, and BACKEND_SECRET on Vercel
INTERSERVICE_SECRET=change-me-to-a-random-secret

# OpenClaw
OPENCLAW_IMAGE=ghcr.io/carmichgo/openclaw:latest
OPENCLAW_NETWORK=ai-employees-internal

# Anthropic API (passed to OpenClaw containers for model access)
ANTHROPIC_API_KEY=

# Google Gemini API (for Nano Banana image gen + Veo 3 video gen)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stripe (for billing & subscriptions)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Platform
PLATFORM_URL=http://localhost:3000
API_PORT=3001

# DigitalOcean API (for auto-provisioning per-company droplets)
# Generate at: https://cloud.digitalocean.com/account/api/tokens
DO_API_TOKEN=

# GitHub repo for cloning on droplets (defaults to carmichgo/ai-employees)
# REPO_URL=https://github.com/carmichgo/ai-employees.git
# REPO_BRANCH=main

# === DO-only env vars (set inside each droplet's .env) ===
# API_DOMAIN=api.yourdomain.com
# ACME_EMAIL=admin@yourdomain.com
