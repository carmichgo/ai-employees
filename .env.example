# Database (Neon Postgres — shared between Vercel and DO)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_employees

# Redis (only needed on DO droplet — set automatically by docker-compose)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# Encryption (for storing channel credentials)
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# Inter-service auth (Vercel → DO API)
# Generate with: openssl rand -hex 32
# Set as INTERSERVICE_SECRET on DO, and BACKEND_SECRET on Vercel
INTERSERVICE_SECRET=change-me-to-a-random-secret

# OpenClaw
OPENCLAW_IMAGE=openclaw:latest
OPENCLAW_NETWORK=ai-employees-internal

# Platform
PLATFORM_URL=http://localhost:3000
API_PORT=3001

# === Vercel-only env vars ===
# Set these in the Vercel dashboard:
# BACKEND_URL=https://api.yourdomain.com   (your DO droplet API URL)
# BACKEND_SECRET=<same as INTERSERVICE_SECRET on DO>

# === DO-only env vars ===
# API_DOMAIN=api.yourdomain.com
# ACME_EMAIL=admin@yourdomain.com
