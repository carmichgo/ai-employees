FROM node:22-alpine AS base
RUN apk add --no-cache docker-cli
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# Install dependencies
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/
COPY packages/openclaw-config/package.json ./packages/openclaw-config/
COPY apps/api/package.json ./apps/api/
RUN pnpm install --frozen-lockfile || pnpm install

# Copy source + turbo config
COPY tsconfig.base.json turbo.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Build all workspace dependencies then the API (turbo handles dependency order)
RUN pnpm turbo build --filter=@ai-employees/api

# Patch package.json main fields from src/index.ts → dist/index.js for Node.js runtime
RUN sed -i 's|"main": "src/index.ts"|"main": "dist/index.js"|g' packages/*/package.json

EXPOSE 3001
CMD ["node", "apps/api/dist/index.js"]
