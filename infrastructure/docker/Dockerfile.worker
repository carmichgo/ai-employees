FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# Install dependencies
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/
COPY packages/openclaw-config/package.json ./packages/openclaw-config/
COPY apps/worker/package.json ./apps/worker/
RUN pnpm install --frozen-lockfile || pnpm install

# Copy source + turbo config
COPY tsconfig.base.json turbo.json ./
COPY packages/ ./packages/
COPY apps/worker/ ./apps/worker/

# Build all workspace dependencies then the worker (turbo handles dependency order)
RUN pnpm turbo build --filter=@ai-employees/worker

CMD ["node", "apps/worker/dist/index.js"]
